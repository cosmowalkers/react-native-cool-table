{
  "name": "react-native-cool-table",
  "version": "0.5.0",
  "description": "A high-performance, feature-rich table component for React Native with fixed columns, sorting, tree rows, inline editing, pagination, and more.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "!lib/typescript/example",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "bob build",
    "release": "release-it",
    "example": "yarn --cwd example",
    "pods": "cd example && pod-install --quiet",
    "bootstrap": "yarn example && yarn && yarn pods"
  },
  "keywords": [
    "react-native",
    "table",
    "datatable",
    "grid",
    "sort",
    "tree",
    "fixed-columns",
    "pagination",
    "inline-edit",
    "ios",
    "android",
    "typescript"
  ],
  "repository": "https://github.com/pangyu1997/react-native-cool-table",
  "author": "mengxiangyu1 <18322276773@163.com> (https://github.com/pangyu1997)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pangyu1997/react-native-cool-table/issues"
  },
  "homepage": "https://github.com/pangyu1997/react-native-cool-table#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^11.0.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@release-it/conventional-changelog": "^2.0.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.14.201",
    "@types/react": "^18.3.31",
    "commitlint": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^4.2.5",
    "jest": "^29.7.0",
    "lodash": "^4.17.21",
    "metro-react-native-babel-preset": "0.76.9",
    "pod-install": "^0.1.0",
    "prettier": "^3.3.3",
    "react": "18.2.0",
    "react-native": "0.72.17",
    "react-native-builder-bob": "^0.23.2",
    "react-test-renderer": "18.3.1",
    "release-it": "^14.2.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "yarn lint && yarn typescript"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ],
      "react/react-in-jsx-scope": "off",
      "react/jsx-uses-react": "off"
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/",
    "coverage/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
